# AINVR uses the pinned existing tokenizer abstraction and checked SP backend.
# Prepare private dependencies using test/search/tokenizer-build-software.py.
option(AINVR_SEARCH_WITH_TOKENIZER "Build the checked production text tokenizer" ON)
if(AINVR_SEARCH_WITH_TOKENIZER)
  set(AINVR_SEARCH_TOKENIZER_WORK "${CMAKE_CURRENT_LIST_DIR}/../../out/search-tokenizer-software" CACHE PATH "Private verified tokenizer build dependencies")
  set(AINVR_TOKENIZERS_CPP_INCLUDE "/mnt/ainvr-ssd/llm-build/third_party/tokenizers-cpp/include" CACHE PATH "Pinned existing tokenizer interface headers (build only)")
  set(AINVR_SP_SHADOW "${AINVR_SEARCH_TOKENIZER_WORK}/source/sentencepiece")
  if(NOT EXISTS "${AINVR_SP_SHADOW}/.ainvr-pinned-source" OR NOT EXISTS "${AINVR_SEARCH_TOKENIZER_WORK}/prefix/lib/cmake/absl/abslConfig.cmake")
    message(FATAL_ERROR "Prepare pinned tokenizer software first: python3 test/search/tokenizer-build-software.py; use AINVR_SEARCH_WITH_TOKENIZER=OFF only for explicitly model-independent development")
  endif()
  file(READ "${AINVR_SP_SHADOW}/.ainvr-pinned-source" AINVR_SP_ID)
  string(STRIP "${AINVR_SP_ID}" AINVR_SP_ID)
  file(SHA256 "${AINVR_TOKENIZERS_CPP_INCLUDE}/tokenizers_cpp.h" AINVR_TOKENIZER_HEADER_SHA)
  if(NOT AINVR_SP_ID STREQUAL "e0f0f966959108415183d6cbe7a9051ca8bc2da1" OR NOT AINVR_TOKENIZER_HEADER_SHA STREQUAL "1d09ab9af975e6f86783ce13d2d7c5a92b22c83eeaa6ccc9581ab3c48b63de14")
    message(FATAL_ERROR "Pinned tokenizer dependency identity mismatch")
  endif()
  list(PREPEND CMAKE_PREFIX_PATH "${AINVR_SEARCH_TOKENIZER_WORK}/prefix")
  find_package(ICU 70 REQUIRED COMPONENTS uc)
  if(NOT ICU_VERSION VERSION_LESS 71)
    message(FATAL_ERROR "The validated normalization contract requires ICU70")
  endif()
  set(SPM_ABSL_PROVIDER package CACHE STRING "" FORCE)
  set(SPM_ENABLE_SHARED OFF CACHE BOOL "" FORCE)
  set(SPM_ENABLE_TCMALLOC OFF CACHE BOOL "" FORCE)
  set(SPM_BUILD_TEST OFF CACHE BOOL "" FORCE)
  add_subdirectory("${AINVR_SP_SHADOW}" sentencepiece-build EXCLUDE_FROM_ALL)
  add_library(ainvr_search_tokenizer ../shared/cpp/checked_sentencepiece_tokenizer.cpp src/siglip_tokenizer.cpp)
  target_include_directories(ainvr_search_tokenizer PUBLIC src ../shared/cpp)
  target_include_directories(ainvr_search_tokenizer SYSTEM PUBLIC "${AINVR_TOKENIZERS_CPP_INCLUDE}")
  target_include_directories(ainvr_search_tokenizer SYSTEM PRIVATE "${AINVR_SP_SHADOW}/src" "${AINVR_SP_SHADOW}/src/builtin_pb" "${AINVR_SP_SHADOW}/third_party/protobuf-lite")
  target_link_libraries(ainvr_search_tokenizer PUBLIC sentencepiece-static ICU::uc)
  target_compile_options(ainvr_search_tokenizer PRIVATE -Wall -Wextra -Werror)
  target_link_libraries(ainvr_search_service PRIVATE ainvr_search_tokenizer)
  add_executable(ainvr_search_tokenizer_test tests/siglip_tokenizer_test.cpp)
  target_link_libraries(ainvr_search_tokenizer_test PRIVATE ainvr_search_tokenizer OpenSSL::Crypto nlohmann_json::nlohmann_json)
  target_compile_options(ainvr_search_tokenizer_test PRIVATE -Wall -Wextra -Werror)
  add_test(NAME search_tokenizer_golden COMMAND ainvr_search_tokenizer_test "${CMAKE_CURRENT_SOURCE_DIR}/../ai-service/models/search/tokenizers/siglip-so400m-i18n.spiece.model" "${CMAKE_CURRENT_SOURCE_DIR}/tests/fixtures/siglip-so400m-hf4463.json")
  add_test(NAME search_tokenizer_unicode COMMAND ainvr_search_tokenizer_test --unicode-digest)
  set_tests_properties(search_tokenizer_golden PROPERTIES TIMEOUT 30)
  set_tests_properties(search_tokenizer_unicode PROPERTIES TIMEOUT 60 PASS_REGULAR_EXPRESSION "2a48439c3e95275cf9c7fba6c4b023766a859b09ca987b2e93ec32288fb0a520")
endif()
