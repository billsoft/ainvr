# Pure contracts can be built in search-service without constructing any device.
if(NOT TARGET ainvr_search_model_package)
  message(FATAL_ERROR "Existing search model-package target is required")
endif()
set(AINVR_VISION_ROOT "${CMAKE_CURRENT_LIST_DIR}/..")
add_library(ainvr_search_bpu_vision_contract "${AINVR_VISION_ROOT}/src/bpu_vision_encoder_contract.cpp")
target_include_directories(ainvr_search_bpu_vision_contract PUBLIC "${AINVR_VISION_ROOT}/src" "${AINVR_VISION_ROOT}/../ai-service/src")
target_include_directories(ainvr_search_bpu_vision_contract SYSTEM PRIVATE /usr/include/hobot)
target_link_libraries(ainvr_search_bpu_vision_contract PUBLIC ainvr_search_model_package)
target_compile_options(ainvr_search_bpu_vision_contract PRIVATE -Wall -Wextra -Werror)
add_executable(ainvr_search_bpu_vision_contract_test "${AINVR_VISION_ROOT}/tests/bpu_vision_encoder_contract_test.cpp")
target_include_directories(ainvr_search_bpu_vision_contract_test SYSTEM PRIVATE /usr/include/hobot)
target_link_libraries(ainvr_search_bpu_vision_contract_test PRIVATE ainvr_search_bpu_vision_contract)
target_compile_options(ainvr_search_bpu_vision_contract_test PRIVATE -Wall -Wextra -Werror)
add_test(NAME search_bpu_vision_software_contract COMMAND ainvr_search_bpu_vision_contract_test)
set_tests_properties(search_bpu_vision_software_contract PROPERTIES TIMEOUT 15)

# Invoke only where the EXISTING AI BpuImageRunner/ImagePreprocessor target is
# already configured. Do not duplicate its GLES/PYM/GDC/BPU implementation here.
function(ainvr_add_search_bpu_vision_encoder existing_bpu_images_target)
  if(NOT TARGET "${existing_bpu_images_target}")
    message(FATAL_ERROR "Vision adapter requires the existing BPU image target")
  endif()
  if(TARGET ainvr_search_bpu_vision_encoder)
    return()
  endif()
  add_library(ainvr_search_bpu_vision_encoder "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/bpu_vision_encoder.cpp")
  target_include_directories(ainvr_search_bpu_vision_encoder SYSTEM PRIVATE /usr/include/hobot)
  target_compile_options(ainvr_search_bpu_vision_encoder PRIVATE -idirafter /usr/hobot/include -Wall -Wextra -Werror)
  target_link_libraries(ainvr_search_bpu_vision_encoder PUBLIC ainvr_search_bpu_vision_contract "${existing_bpu_images_target}")
endfunction()
