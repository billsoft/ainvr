# Control-plane adapter only: reuse the pinned management transport, no DB/BPU.
set(AINVR_INDEX_JOB_ROOT "${CMAKE_CURRENT_LIST_DIR}/..")
add_library(ainvr_search_index_jobs "${AINVR_INDEX_JOB_ROOT}/src/index_job_client.cpp")
target_include_directories(ainvr_search_index_jobs PUBLIC "${AINVR_INDEX_JOB_ROOT}/src")
target_link_libraries(ainvr_search_index_jobs PUBLIC ainvr_search_http_transport ainvr_search_sample_contract nlohmann_json::nlohmann_json)
target_compile_options(ainvr_search_index_jobs PRIVATE -Wall -Wextra -Werror)
add_executable(ainvr_search_index_job_client_test "${AINVR_INDEX_JOB_ROOT}/tests/index_job_client_test.cpp")
target_link_libraries(ainvr_search_index_job_client_test PRIVATE ainvr_search_index_jobs)
target_compile_options(ainvr_search_index_job_client_test PRIVATE -Wall -Wextra -Werror)
add_test(NAME search_index_job_client COMMAND ainvr_search_index_job_client_test)
set_tests_properties(search_index_job_client PROPERTIES TIMEOUT 20)
add_executable(ainvr_search_storage_uuid_test "${AINVR_INDEX_JOB_ROOT}/tests/sample_storage_uuid_test.cpp")
target_link_libraries(ainvr_search_storage_uuid_test PRIVATE ainvr_search_sample_contract)
target_compile_options(ainvr_search_storage_uuid_test PRIVATE -Wall -Wextra -Werror)
add_test(NAME search_storage_uuid COMMAND ainvr_search_storage_uuid_test)
