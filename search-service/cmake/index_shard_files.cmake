# File projection only; no BPU target, storage mount, runtime instance or DB.
find_package(OpenSSL REQUIRED)
find_package(nlohmann_json REQUIRED)
find_package(Threads REQUIRED)
set(AINVR_SHARD_SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/..")
add_library(ainvr_search_index_shard_files "${AINVR_SHARD_SOURCE_ROOT}/src/index_shard_files.cpp")
target_include_directories(ainvr_search_index_shard_files PUBLIC "${AINVR_SHARD_SOURCE_ROOT}/src")
target_link_libraries(ainvr_search_index_shard_files PUBLIC OpenSSL::Crypto nlohmann_json::nlohmann_json Threads::Threads)
target_compile_options(ainvr_search_index_shard_files PRIVATE -Wall -Wextra -Werror)
# The ordinary-directory factory does not exist in the production library.
add_library(ainvr_search_index_shard_files_test_impl STATIC "${AINVR_SHARD_SOURCE_ROOT}/src/index_shard_files.cpp")
target_compile_definitions(ainvr_search_index_shard_files_test_impl PUBLIC AINVR_SHARD_FILES_TESTING=1)
target_include_directories(ainvr_search_index_shard_files_test_impl PUBLIC "${AINVR_SHARD_SOURCE_ROOT}/src")
target_link_libraries(ainvr_search_index_shard_files_test_impl PUBLIC OpenSSL::Crypto nlohmann_json::nlohmann_json Threads::Threads)
target_compile_options(ainvr_search_index_shard_files_test_impl PRIVATE -Wall -Wextra -Werror)
add_executable(ainvr_search_index_shard_files_test "${AINVR_SHARD_SOURCE_ROOT}/tests/index_shard_files_test.cpp")
target_link_libraries(ainvr_search_index_shard_files_test PRIVATE ainvr_search_index_shard_files_test_impl)
target_compile_options(ainvr_search_index_shard_files_test PRIVATE -Wall -Wextra -Werror)
add_test(NAME search_index_shard_files COMMAND ainvr_search_index_shard_files_test)
set_tests_properties(search_index_shard_files PROPERTIES TIMEOUT 30)
