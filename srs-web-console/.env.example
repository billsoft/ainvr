# ===== SRS Web Console 环境变量示例 =====
# 复制为 .env 后修改

# WebRTC 播放地址无需在此配置：默认按浏览器访问地址自动适配，特殊网络在控制台
# 「系统配置 → 流媒体配置 → WebRTC 播放地址」指定（旧版的 SRS_CANDIDATE 已不再使用）。

# ===== PostgreSQL（统一配置中心） =====
# PostgreSQL 数据库密码（生产环境请务必修改为强密码）
POSTGRES_PASSWORD=

# 服务间令牌（每服务独立，token 推导服务身份，防冒充拉别家 secrets）。
# BFF 容器与各微服务 systemd unit 必须同值（同服务的两处一致）。
# 生成方式：openssl rand -hex 24
# 未设置时服务间通信可用（无密码模式），但 secret 占位符永不解密。
CONFIG_SERVICE_TOKEN_RECORDER=change-me
CONFIG_SERVICE_TOKEN_AI_SERVICE=change-me

# 重启助手（ainvr-restart-helper.service，宿主机 127.0.0.1:8199，仅本机
# 监听）——backend 容器够不着宿主机 systemd，配置发布后需要重启
# ai-service/recorder 时靠这个助手代劳。同值写在宿主机
# /etc/ainvr-ai/restart-helper.env（chmod 0600）。
# 生成方式：python3 -c "import secrets; print(secrets.token_hex(32))"
RESTART_HELPER_URL=http://host.docker.internal:8199
RESTART_HELPER_TOKEN=change-me

# 系统操作助手（ainvr-os-helper.service，宿主机 8299）：网络管理（网卡列表/
# IP 配置安全回滚/WiFi/连通性检测）。token 同值写在宿主机
# /etc/ainvr-ai/os-helper.env（chmod 0600）。留空则控制台网络页返回 503。
OS_HELPER_URL=http://host.docker.internal:8299
OS_HELPER_TOKEN=change-me

# 授权服务（ainvr-license.service，宿主机 127.0.0.1:8001 + UDS）：
# admin key 必须与 /etc/ainvr-license/license-service.yaml 里的 admin_api_key
# 凭据从 /etc/ainvr-license/console-backend.env 注入，不在本文件复制。
# 生产默认强制授权，缺少凭据会拒绝业务但保留登录和授权管理。
LICENSE_ENV_FILE=/etc/ainvr-license/console-backend.env
# 安装脚本自动采用 ainvr 用户组 ID；手动 compose 时先 export AINVR_GID=$(id -g sunrise)。
# 外层 HTTPS 反向代理的实际来源 IP/CIDR；默认空，不信任外部代理头。
# 仅填受控代理，例如 192.168.100.10/32；外层必须覆盖 X-Forwarded-For/Proto。
TRUSTED_EDGE_PROXY_CIDRS=
