# Shared search preparation owner. Include after search_vision.cmake (and after
# ainvr_snapshot exists). Merely linking these targets never loads a device.
include_guard(GLOBAL)
set(AINVR_SEARCH_HW_ROOT "${CMAKE_CURRENT_LIST_DIR}/../..")
if(NOT TARGET ainvr_search_sample_contract)
  add_library(ainvr_search_sample_contract "${AINVR_SEARCH_HW_ROOT}/search-service/src/sample_contract.cpp")
  target_include_directories(ainvr_search_sample_contract PUBLIC "${AINVR_SEARCH_HW_ROOT}/search-service/src")
  target_link_libraries(ainvr_search_sample_contract PUBLIC OpenSSL::Crypto nlohmann_json::nlohmann_json)
  target_compile_options(ainvr_search_sample_contract PRIVATE -Wall -Wextra -Werror)
endif()
if(TARGET ainvr_reused_controller)
  target_link_libraries(ainvr_reused_controller PUBLIC ainvr_search_sample_contract)
endif()
add_library(ainvr_search_hardware_owner
 "${AINVR_SEARCH_HW_ROOT}/ai-service/src/output/search_hardware_owner.cpp"
 "${AINVR_SEARCH_HW_ROOT}/ai-service/src/output/search_prepared_sample.cpp")
target_include_directories(ainvr_search_hardware_owner PUBLIC "${AINVR_SEARCH_HW_ROOT}/ai-service/src")
target_link_libraries(ainvr_search_hardware_owner PUBLIC ainvr_config ainvr_ai_core ainvr_search_sample_contract PkgConfig::MONGOC Threads::Threads)
target_compile_options(ainvr_search_hardware_owner PRIVATE -Wall -Wextra -Werror)
if(TARGET ainvr_snapshot AND TARGET ainvr_search_bpu_vision_encoder)
 add_library(ainvr_search_hardware_native "${AINVR_SEARCH_HW_ROOT}/ai-service/src/output/search_hardware_native.cpp")
 target_link_libraries(ainvr_search_hardware_native PUBLIC ainvr_search_hardware_owner ainvr_snapshot ainvr_search_bpu_vision_encoder ainvr_vpu)
 target_include_directories(ainvr_search_hardware_native SYSTEM PRIVATE /usr/include/hobot)
 target_compile_options(ainvr_search_hardware_native PRIVATE -idirafter /usr/hobot/include -Wall -Wextra -Werror)
endif()
if(BUILD_TESTING)
 add_executable(ainvr_search_reencode_owner_test "${AINVR_SEARCH_HW_ROOT}/test/search/search_reencode_owner_test.cpp")
 target_link_libraries(ainvr_search_reencode_owner_test PRIVATE ainvr_search_hardware_owner)
 target_compile_options(ainvr_search_reencode_owner_test PRIVATE -Wall -Wextra -Werror)
 add_test(NAME search_reencode_owner_software COMMAND ainvr_search_reencode_owner_test)
 set_tests_properties(search_reencode_owner_software PROPERTIES TIMEOUT 20)
 add_executable(search_reencode_http_contract_test "${AINVR_SEARCH_HW_ROOT}/test/search/search_reencode_http_contract_test.cpp")
 target_include_directories(search_reencode_http_contract_test PRIVATE "${AINVR_SEARCH_HW_ROOT}/ai-service/src")
 target_link_libraries(search_reencode_http_contract_test PRIVATE ainvr_search_sample_contract)
 target_compile_options(search_reencode_http_contract_test PRIVATE -Wall -Wextra -Werror)
 add_test(NAME search_reencode_http_contract COMMAND search_reencode_http_contract_test)
 set_tests_properties(search_reencode_http_contract PROPERTIES TIMEOUT 15)
 add_executable(ainvr_search_hardware_owner_test "${AINVR_SEARCH_HW_ROOT}/test/search/search_hardware_owner_test.cpp")
 target_link_libraries(ainvr_search_hardware_owner_test PRIVATE ainvr_search_hardware_owner)
 target_compile_options(ainvr_search_hardware_owner_test PRIVATE -Wall -Wextra -Werror)
 add_test(NAME search_hardware_owner_software COMMAND ainvr_search_hardware_owner_test)
 set_tests_properties(search_hardware_owner_software PROPERTIES TIMEOUT 15)
endif()

if(AINVR_BUILD_SEARCH_E2E_PROBES AND TARGET ainvr_search_hardware_native)
 add_executable(ainvr_search_reencode_control_probe EXCLUDE_FROM_ALL "${AINVR_SEARCH_HW_ROOT}/test/search/reencode_control_probe.cpp")
 target_include_directories(ainvr_search_reencode_control_probe PRIVATE "${AINVR_SEARCH_HW_ROOT}/ai-service/src")
 target_link_libraries(ainvr_search_reencode_control_probe PRIVATE ainvr_reused_controller ainvr_search_hardware_native ainvr_search_sampling Threads::Threads)
 target_compile_definitions(ainvr_search_reencode_control_probe PRIVATE AINVR_SEARCH_PROBE_RESULTS_ROOT="${AINVR_SEARCH_HW_ROOT}/test/results")
 target_compile_options(ainvr_search_reencode_control_probe PRIVATE -Wall -Wextra -Werror)
 set_target_properties(ainvr_search_reencode_control_probe PROPERTIES BUILD_RPATH /usr/hobot/lib)
 # Explicit manual --run-hardware only, never a device CTest.
endif()
