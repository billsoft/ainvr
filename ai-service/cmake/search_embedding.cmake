# Qwen3-VL-Embedding-2B runtime (nine HBM packages, one weight owner) and its local text-query channel.
include_guard(GLOBAL)
set(AINVR_EMB_ROOT "${CMAKE_CURRENT_LIST_DIR}/../..")
add_library(ainvr_embed_ipc "${AINVR_EMB_ROOT}/shared/cpp/embed_ipc.cpp")
target_include_directories(ainvr_embed_ipc PUBLIC "${AINVR_EMB_ROOT}/shared/cpp")
target_link_libraries(ainvr_embed_ipc PUBLIC nlohmann_json::nlohmann_json Threads::Threads)
target_compile_options(ainvr_embed_ipc PRIVATE -Wall -Wextra -Werror)
add_library(ainvr_search_qwen_runtime "${AINVR_EMB_ROOT}/ai-service/src/output/search_qwen_runtime.cpp")
target_include_directories(ainvr_search_qwen_runtime PUBLIC "${AINVR_EMB_ROOT}/ai-service/src")
target_include_directories(ainvr_search_qwen_runtime SYSTEM PRIVATE /usr/include/hobot)
target_compile_options(ainvr_search_qwen_runtime PRIVATE -idirafter /usr/hobot/include -Wall -Wextra -Werror)
target_link_libraries(ainvr_search_qwen_runtime PUBLIC ainvr_qwen3vl_embedding ainvr_embed_ipc ainvr_search_model_package ainvr_bpu ainvr_search_hardware_owner /usr/hobot/lib/libhbmem.so.1)
add_library(ainvr_qwen3vl_embedding
  "${AINVR_EMB_ROOT}/ai-service/src/embedding/qwen_tokenizer.cpp"
  "${AINVR_EMB_ROOT}/ai-service/src/embedding/qwen3vl_host.cpp"
  "${AINVR_EMB_ROOT}/ai-service/src/embedding/qwen3vl_embedder.cpp"
  "${AINVR_EMB_ROOT}/ai-service/src/platform/bpu_pack.cpp")
target_include_directories(ainvr_qwen3vl_embedding PUBLIC "${AINVR_EMB_ROOT}/ai-service/src")
target_include_directories(ainvr_qwen3vl_embedding SYSTEM PRIVATE /usr/include/hobot)
target_compile_options(ainvr_qwen3vl_embedding PRIVATE -idirafter /usr/hobot/include -Wall -Wextra -Werror)
target_link_libraries(ainvr_qwen3vl_embedding PUBLIC ainvr_bpu nlohmann_json::nlohmann_json Threads::Threads)
if(BUILD_TESTING)
  add_executable(ainvr_qwen_runtime_host_test "${AINVR_EMB_ROOT}/test/search/qwen_runtime_host_test.cpp")
  target_link_libraries(ainvr_qwen_runtime_host_test PRIVATE ainvr_search_qwen_runtime)
  target_compile_options(ainvr_qwen_runtime_host_test PRIVATE -Wall -Wextra -Werror)
  set_target_properties(ainvr_qwen_runtime_host_test PROPERTIES BUILD_RPATH /usr/hobot/lib)
  add_test(NAME qwen_runtime_host_software COMMAND ainvr_qwen_runtime_host_test)
  set_tests_properties(qwen_runtime_host_software PROPERTIES TIMEOUT 60)
  add_executable(ainvr_qwen3vl_embedding_test "${AINVR_EMB_ROOT}/test/search/qwen3vl_embedding_test.cpp")
  target_link_libraries(ainvr_qwen3vl_embedding_test PRIVATE ainvr_qwen3vl_embedding ainvr_embed_ipc)
  target_compile_options(ainvr_qwen3vl_embedding_test PRIVATE -Wall -Wextra -Werror)
  set_target_properties(ainvr_qwen3vl_embedding_test PROPERTIES BUILD_RPATH /usr/hobot/lib)
  add_test(NAME qwen3vl_embedding_software COMMAND ainvr_qwen3vl_embedding_test)
  set_tests_properties(qwen3vl_embedding_software PROPERTIES TIMEOUT 60 SKIP_RETURN_CODE 77)
  add_executable(ainvr_qwen3vl_embed_cli "${AINVR_EMB_ROOT}/test/search/qwen3vl_embed_cli.cpp")
  target_link_libraries(ainvr_qwen3vl_embed_cli PRIVATE ainvr_qwen3vl_embedding)
  target_compile_options(ainvr_qwen3vl_embed_cli PRIVATE -Wall -Wextra -Werror)
  set_target_properties(ainvr_qwen3vl_embed_cli PROPERTIES BUILD_RPATH /usr/hobot/lib)
endif()

if(BUILD_TESTING AND TARGET ainvr_vpu AND TARGET ainvr_image_preprocessor)
  # Hardware probe: runs only when invoked by hand with the production AI service paused; never registered with CTest.
  add_executable(ainvr_qwen3vl_vision_probe EXCLUDE_FROM_ALL "${AINVR_EMB_ROOT}/test/search/qwen3vl_vision_probe.cpp")
  target_link_libraries(ainvr_qwen3vl_vision_probe PRIVATE ainvr_qwen3vl_embedding ainvr_vpu ainvr_image_preprocessor ainvr_snapshot)
  target_compile_options(ainvr_qwen3vl_vision_probe PRIVATE -idirafter /usr/hobot/include -Wall -Wextra -Werror)
  set_target_properties(ainvr_qwen3vl_vision_probe PROPERTIES BUILD_RPATH /usr/hobot/lib)
endif()
