# os-helper 环境变量示例
# 复制到 /etc/ainvr-ai/os-helper.env 并 chmod 600

# 鉴权 token（必须设置，否则服务拒绝启动）
# 生成: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OS_HELPER_TOKEN=your-secret-token-here

# 监听端口（默认 8299）
OS_HELPER_PORT=8299

# 连通性检测用的公网 IP（可选，有默认值）
# CHECK_V4=223.5.5.5,1.1.1.1
# CHECK_V6=2400:3200::1,2606:4700:4700::1111
# CHECK_DOMAIN=www.baidu.com
