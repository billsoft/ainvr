+// Only coordinator threads acquire a staging lease; pool workers never wait
+// for this budget, preventing a queue/budget circular wait across channels.
+class CropStageLease {
+ public:
+  static constexpr size_t Limit = size_t(32)<<20;
+  explicit CropStageLease(size_t bytes):bytes_(bytes) {
+    if(bytes>Limit)throw std::invalid_argument("crop staging exceeds budget");
+    auto& state=State();std::unique_lock<std::mutex> lock(state.mutex);
+    state.changed.wait(lock,[&]{return state.used<=Limit-bytes;});
+    state.used+=bytes;
+  }
+  ~CropStageLease(){auto& state=State();
+    {std::lock_guard<std::mutex> lock(state.mutex);state.used-=bytes_;}
+    state.changed.notify_all();
+  }
+  CropStageLease(const CropStageLease&)=delete;
+  CropStageLease& operator=(const CropStageLease&)=delete;
+ private:
+  struct Budget {std::mutex mutex;std::condition_variable changed;size_t used=0;};
+  static Budget& State(){static Budget state;return state;}
+  size_t bytes_;
+};
