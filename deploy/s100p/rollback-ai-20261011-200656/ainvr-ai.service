[Unit]
Description=AINVR native AI service on RDK S100P
After=network-online.target ainvr-license.service docker.service
Wants=network-online.target ainvr-license.service

[Service]
Type=simple
User=sunrise
Group=sunrise
WorkingDirectory=/home/sunrise/ainvr/ai-service
EnvironmentFile=/home/sunrise/ainvr/deploy/s100p/runtime/ai-service.env
ExecStart=/home/sunrise/ainvr/deploy/s100p/bin/ainvr_ai_service /home/sunrise/ainvr/deploy/s100p/runtime/ai-service.json /home/sunrise/ainvr/data/ai/config_overlay.json /home/sunrise/ainvr/ai-service /home/sunrise/ainvr/deploy/s100p/runtime/ai-service.env
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
